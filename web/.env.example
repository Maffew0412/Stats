# Supabase project — copy values from https://supabase.com/dashboard/project/_/settings/api

# Postgres connection. Use the pooled connection string (port 6543) for the Next.js
# runtime (serverless-friendly) and the direct connection (port 5432) for drizzle-kit
# migrations. For MVP simplicity a single direct URL works for both.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Public Supabase keys — safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
